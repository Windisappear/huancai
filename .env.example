DATABASE_URL=postgresql://frame:frame_local_only@127.0.0.1:55432/frame
REDIS_URL=redis://127.0.0.1:16379
APP_ORIGIN=http://localhost:3000
SESSION_SECURE=false
# Only enable in a private test environment. No real payments, no real AI generation.
DEMO_MODE=false
# S3 by default. local is accepted only together with DEMO_MODE=true, for offline tests.
STORAGE_DRIVER=s3
# For local demo only; absolute path avoids standalone/Worker working-directory differences.
LOCAL_STORAGE_ROOT=
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=frame-private
S3_ACCESS_KEY=frame_local
S3_SECRET_KEY=frame_local_storage_only
WORKER_CONCURRENCY=2
# Optional: trusted HTTPS alert webhook, sent only machine event names (no prompts or credentials)
ALERT_WEBHOOK=
# Reserved, not active until adapters are implemented and tested:
RELAY_BASE_URL=https://api.laoliimage2.win
RELAY_API_KEY=
