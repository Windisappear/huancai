generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  username String @unique
  passwordHash String
  recoveryHash String
  role String @default("USER")
  phone String?
  email String?
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
}
model Session {
  tokenHash String @id
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model Wallet {
  userId String @id
  available Int @default(0)
  frozen Int @default(0)
}
model Ledger {
  id String @id @default(cuid())
  userId String
  eventKey String @unique
  kind String
  availableDelta Int
  frozenDelta Int
  reference String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model Channel {
  id String @id
  name String
  adapter String
  baseUrl String?
  secretEnv String?
  enabled Boolean @default(false)
  verified Boolean @default(false)
}
model ProviderAccount {
  id String @id @default(cuid())
  channelId String
  name String
  secretEnv String @unique
  group String @default("default")
  enabled Boolean @default(true)
  maxInFlight Int @default(2)
  cooldownUntil DateTime?
  lastUsedAt DateTime?
  lastError String?
  checkedAt DateTime?
  accessibleModels Json?
  @@index([channelId, enabled])
}
model ModelRoute {
  id String @id
  modelId String
  channelId String
  upstreamModel String
  adapter String
  mode String
  size String
  quality String
  params Json
  requiredGroup String @default("default")
  costMicros Int
  priority Int @default(0)
  maxReferences Int @default(0)
  enabled Boolean @default(true)
  priceNote String @default("")
  @@index([modelId, enabled])
}
model Model {
  id String @id
  name String
  family String
  mediaType String @default("IMAGE")
  channelId String
  upstreamModel String
  enabled Boolean @default(false)
  sizes Json
  qualities Json
  maxCount Int @default(1)
  maxReferences Int @default(0)
  pooled Boolean @default(false)
}
model Price {
  id String @id @default(cuid())
  modelId String
  mode String
  size String
  quality String
  unitCents Int
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([modelId, active])
}
model Quote {
  id String @id @default(cuid())
  userId String
  modelId String
  priceId String
  mode String
  size String
  quality String
  count Int
  unitCents Int
  expiresAt DateTime
}
model Task {
  id String @id @default(cuid())
  userId String
  requestKey String
  quoteId String @unique
  modelId String
  modelName String
  channelId String
  adapter String
  upstreamModel String
  mediaType String @default("IMAGE")
  mode String
  size String
  quality String
  count Int
  unitCents Int
  priceId String
  status String @default("QUEUED")
  upstreamId String?
  upstreamCost Decimal? @db.Decimal(18, 6)
  accountId String?
  routeId String?
  endpointBaseUrl String?
  credentialEnv String?
  upstreamParams Json?
  estimatedCostMicros Int?
  deliveredCount Int @default(0)
  error String?
  settledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([accountId, settledAt])
}
// Creative content is isolated from financial records; exclude from long-term backups.
model TaskContent {
  taskId String @id
  prompt String
  referenceIds Json
  expiresAt DateTime
}
model Asset {
  id String @id @default(cuid())
  userId String
  taskId String?
  slot Int?
  kind String
  key String @unique
  mime String
  width Int
  height Int
  bytes Int
  ready Boolean @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  deletedAt DateTime?
  purgedAt DateTime?
  @@unique([taskId, slot])
  @@index([userId, expiresAt])
}
model Outbox {
  id String @id @default(cuid())
  taskId String @unique
  sentAt DateTime?
  createdAt DateTime @default(now())
}
model Payment {
  id String @id @default(cuid())
  userId String
  requestKey String
  provider String
  amount Int
  status String @default("PENDING")
  transactionId String? @unique
  refunded Int @default(0)
  createdAt DateTime @default(now())
  @@unique([userId, requestKey])
}
model Refund {
  id String @id @default(cuid())
  paymentId String @unique
  userId String
  amount Int
  status String @default("REVIEW")
  createdAt DateTime @default(now())
}
model Audit {
  id String @id @default(cuid())
  actorId String
  action String
  reference String
  createdAt DateTime @default(now())
}
